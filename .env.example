# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================

# Supabase (OBLIGATORIO para autenticación segura)
# Obtén estas credenciales en https://supabase.com/dashboard/
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ⚠️ IMPORTANTE: Nunca subas este archivo a Git
# ⚠️ Usa .env.local para desarrollo (no se sube a Git)
# ⚠️ Configura variables de entorno en tu hosting para producción

# ============================================
# CONFIGURACIÓN DE IA (OPCIONAL)
# ============================================

# OpenAI (para generación de recetas)
VITE_OPENAI_API_KEY=sk-...

# O Anthropic (alternativa)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# CONFIGURACIÓN DE SEGURIDAD ADICIONAL
# ============================================

# Habilitar verificación de email (recomendado)
# VITE_REQUIRE_EMAIL_CONFIRMATION=true

# Configuración de sesiones
# VITE_SESSION_TIMEOUT=3600 (1 hora en segundos)
# VITE_REFRESH_TOKEN_ROTATION=true

# Rate limiting (configurar en Supabase Dashboard)
# Ver SEGURIDAD.md para más detalles
